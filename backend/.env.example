# Copy this file to .env and fill in real values. Never commit .env.

# Main database used when running the app.
DATABASE_URL=postgresql+psycopg://vanatrack:vanatrack@localhost:5432/vanatrack

# Separate database used only by pytest. Tests delete data freely here.
TEST_DATABASE_URL=postgresql+psycopg://vanatrack:vanatrack@localhost:5432/vanatrack_test

# Secret used to sign login tokens. Required, at least 32 characters.
# Generate a strong one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# Comma-separated list of frontend URLs allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# Time zone that decides "today" for schedule and dashboard maths (IANA name).
APP_TIMEZONE=Asia/Kolkata

# Rough estimate of CO2 one tree absorbs per year, used by the dashboard.
CO2_KG_PER_TREE_PER_YEAR=21
